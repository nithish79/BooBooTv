<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:keepScreenOn="true">

    <!-- ========================================================= -->
    <!-- 1. HOME SCREEN CONTAINER                                  -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/homeScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:visibility="visible">

        <!-- Top Navigation Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Boo Boo TV Logo"
                android:src="@drawable/ic_booboo_mascot" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Boo Boo TV"
                    android:textColor="@color/brand_focused"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Developed by Bidhu Nithish"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActiveSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginLeft="14dp"
                android:background="@drawable/bg_badge"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Free-TV Global • 2,068 Channels" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnHomeSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_category_item"
                android:contentDescription="Search"
                android:focusable="true"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btnHomeReload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_category_item"
                android:contentDescription="Reload"
                android:focusable="true"
                android:src="@drawable/ic_presets" />

            <ImageButton
                android:id="@+id/btnHomeSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_category_item"
                android:contentDescription="Settings"
                android:focusable="true"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Main Section Navigation Tabs -->
        <LinearLayout
            android:id="@+id/sectionTabsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNavPresets"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_category_item"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="⚡ Presets"
                android:textColor="@color/brand_focused"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNavGenres"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_category_item"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="🎭 Genres"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNavRegions"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_category_item"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="🌍 Regions"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNavFavorites"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_category_item"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="★ Favorites"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNavRecents"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_category_item"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="🕒 Recent"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sub-filter / Chips Horizontal Scroll -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSubFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:focusable="false"
            android:orientation="horizontal"
            tools:layout_height="44dp" />

        <!-- Search Input Bar (Seamless focus flow) -->
        <EditText
            android:id="@+id/etHomeSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_focus_card"
            android:drawableStart="@drawable/ic_search"
            android:drawableLeft="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Search channel name, number or genre..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:nextFocusDown="@+id/rvHomeChannels"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Channel Grid / List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:nextFocusUp="@+id/etHomeSearch"
            tools:listitem="@layout/item_channel_card" />

        <!-- Bottom Remote Navigation Hints -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHomeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK: Play Channel • Long-OK: Star Favorite • BACK: Exit Dialog"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- 2. FULLSCREEN PLAYER CONTAINER                            -->
    <!-- ========================================================= -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- Buffering Indicator -->
        <LinearLayout
            android:id="@+id/bufferingContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_focus_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/brand_focused" />

            <TextView
                android:id="@+id/tvBufferingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Buffering live broadcast..."
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Error Overlay -->
        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_focus_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="380dp"
                android:text="@string/error_playback"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRetryStream"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_category_item"
                    android:focusable="true"
                    android:text="Retry Stream"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnNextAlternative"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/bg_category_item"
                    android:focusable="true"
                    android:text="Next Source"
                    android:textColor="@color/brand_focused"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnBackToHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/bg_category_item"
                    android:focusable="true"
                    android:text="Back to Home"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- In-Player Interactive Controls HUD (Auto-Hides) -->
        <LinearLayout
            android:id="@+id/playerControlsHud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_osd_gradient"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <!-- Row 1: Channel Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOsdNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_focused"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="01" />

                <ImageView
                    android:id="@+id/ivOsdLogo"
                    android:layout_width="50dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginLeft="14dp"
                    android:background="#1e293b"
                    android:contentDescription="Channel Logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tv" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOsdName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Sky News UK" />

                        <ImageView
                            android:id="@+id/ivOsdFavorite"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginLeft="10dp"
                            android:contentDescription="Favorite"
                            android:src="@drawable/ic_star_filled"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOsdCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="News • UK" />

                        <TextView
                            android:id="@+id/tvOsdQuality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginLeft="8dp"
                            android:background="@drawable/bg_badge"
                            android:textColor="@color/brand_focused"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="1080P" />

                        <TextView
                            android:id="@+id/tvOsdSourceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginLeft="8dp"
                            android:background="@drawable/bg_badge"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            tools:text="Source 1/2" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#20000000"
                    android:padding="6dp"
                    android:text="@string/channel_zap_hint"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 2: Interactive Player Remote Controls -->
            <LinearLayout
                android:id="@+id/playerButtonRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnHudPlayPause"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="⏸ Pause"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHudPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="⏮ Prev Ch"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnHudNext"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="⏭ Next Ch"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnHudAspect"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="Aspect: 16:9"
                    android:textColor="@color/brand_focused"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHudSource"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="Source: 1/1"
                    android:textColor="@color/brand_focused"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHudQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="Res: Auto"
                    android:textColor="@color/brand_focused"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHudFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="★ Star"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnHudHome"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="🏠 Main Home"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ========================================================= -->
    <!-- 3. SETTINGS OVERLAY MODAL                                 -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_focus_card"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boo Boo TV Settings"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Aspect Ratio"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAspect16_9"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_item"
                android:focusable="true"
                android:text="16:9"
                android:textColor="@color/brand_focused"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAspect4_3"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_item"
                android:focusable="true"
                android:text="4:3"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAspectFill"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_item"
                android:focusable="true"
                android:text="Stretch"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAspectZoom"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_item"
                android:focusable="true"
                android:text="Zoom"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Audio Volume Boost"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAudioBoost100"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_item"
                android:focusable="true"
                android:text="100%"
                android:textColor="@color/brand_focused"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAudioBoost150"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_item"
                android:focusable="true"
                android:text="150%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAudioBoost200"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_item"
                android:focusable="true"
                android:text="200%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_category_item"
            android:focusable="true"
            android:text="Done / Close"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- 4. EXIT CONFIRMATION DIALOG OVERLAY                       -->
    <!-- ========================================================= -->
    <FrameLayout
        android:id="@+id/exitDialogOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3020617"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_focus_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Exit Icon"
                android:src="@drawable/ic_booboo_mascot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Exit Boo Boo TV?"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Are you sure you want to exit the application?"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelExit"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="Cancel"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnConfirmExit"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_category_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="Exit App"
                    android:textColor="@color/accent_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ========================================================= -->
    <!-- 5. BOO BOO TV CUTE FLASH / SPLASH SCREEN                  -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/splashContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#facc15"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:id="@+id/ivSplashMascot"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="Boo Boo TV Mascot"
            android:src="@drawable/ic_booboo_mascot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Boo Boo TV"
            android:textColor="#0f172a"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Cute, Fun &amp; Free Live Television ✨"
            android:textColor="#334155"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Developed by Bidhu Nithish"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="italic" />

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="22dp"
            android:indeterminateTint="#0f172a" />
    </LinearLayout>

</FrameLayout>